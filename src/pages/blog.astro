---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const articles = await getCollection("articles");
const categories = [...new Set(articles.map(a => a.data.category))].sort();
const allTags = [...new Set(articles.flatMap(a => a.data.tags))].sort();

const url = new URL(Astro.request.url);
const activeCategory = url.searchParams.get("category");
const activeTag = url.searchParams.get("tag");

const filtered = articles
  .filter(a => !activeCategory || a.data.category === activeCategory)
  .filter(a => !activeTag || a.data.tags.includes(activeTag))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title="All Articles — DevToolCompare"
  description="Browse all developer tool comparisons, reviews, and guides."
>
  <div class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-white mb-2">All Articles</h1>
    <p class="text-zinc-400 mb-8">{articles.length} articles and counting</p>

    <div class="flex flex-wrap gap-2 mb-8">
      <a href="/blog" class={`text-sm px-3 py-1.5 rounded-full border transition-colors no-underline ${!activeCategory && !activeTag ? "bg-indigo-600 border-indigo-500 text-white" : "bg-zinc-900 border-zinc-800 text-zinc-400 hover:text-white"}`}>
        All
      </a>
      {categories.map(c => (
        <a href={`/blog?category=${c}`} class={`text-sm px-3 py-1.5 rounded-full border transition-colors no-underline ${activeCategory === c ? "bg-indigo-600 border-indigo-500 text-white" : "bg-zinc-900 border-zinc-800 text-zinc-400 hover:text-white"}`}>
          {c}
        </a>
      ))}
    </div>

    <div class="grid md:grid-cols-2 gap-5">
      {filtered.map(a => (
        <a href={`/article/${a.id}`} class="group block bg-zinc-900/30 border border-zinc-800/50 rounded-xl p-5 hover:border-zinc-700 transition-all no-underline">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-medium text-indigo-400">{a.data.category}</span>
            <span class="text-xs text-zinc-600">{a.data.pubDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</span>
          </div>
          <h2 class="text-base font-semibold text-white group-hover:text-indigo-400 transition-colors">{a.data.title}</h2>
          <p class="text-sm text-zinc-400 mt-1.5 line-clamp-2">{a.data.description}</p>
          <div class="flex gap-1.5 mt-2">
            {a.data.tags.slice(0, 4).map(t => (
              <span class="text-xs text-zinc-600">#{t}</span>
            ))}
          </div>
        </a>
      ))}
    </div>

    {filtered.length === 0 && (
      <div class="text-center py-16 text-zinc-500">
        <p>No articles found in this category yet.</p>
        <a href="/blog" class="text-indigo-400 hover:text-indigo-300 mt-2 inline-block">View all articles</a>
      </div>
    )}
  </div>
</BaseLayout>